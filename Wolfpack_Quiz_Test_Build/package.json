{
  "name": "wolfpack-quiz-games",
  "version": "0.1.0",
  "private": true,
  "description": "The Hunt and Beat the Wolfpack playable prototype",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run build:stage && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run build:stage && electron-builder --mac dmg --publish never",
    "build:stage": "esbuild app/stage3d.js --bundle --format=iife --platform=browser --outfile=app/stage3d.bundle.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "three": "^0.171.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.wolfpackstudios.quizgames",
    "productName": "Wolfpack Quiz Games",
    "files": [
      "main.js",
      "app/**/*",
      "package.json",
      "app/stage3d.bundle.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": "dmg"
    }
  },
  "author": "Wolfpack Studios",
  "repository": {
    "type": "git",
    "url": "https://github.com/Becksploder2/The-Hunt.git"
  }
}
