{
  "name": "wolfpack-quiz-games",
  "version": "0.1.0",
  "private": true,
  "description": "The Hunt and Beat the Wolfpack playable prototype",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wolfpackstudios.quizgames",
    "productName": "Wolfpack Quiz Games",
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": "dmg"
    }
  },
  "author": "Wolfpack Studios",
  "repository": {
    "type": "git",
    "url": "https://github.com/Becksploder2/The-Hunt.git"
  }
}
